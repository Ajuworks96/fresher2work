# FresherToWork Backend API Environment Variables

PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fresher2work?schema=public

# JWT Security
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay ₹99 INR Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Object Storage (Cloudflare R2 / AWS S3)
STORAGE_BUCKET=fresher2work-uploads
STORAGE_PUBLIC_URL=https://assets.fresher2work.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# CORS
CORS_ORIGIN=*
